# Threat Model Automator Configuration
# Copy to config.yaml and fill in your values

jira:
  server: https://your-org.atlassian.net
  email: your-email@company.com
  api_token: your-jira-api-token
  project_key: TM
  request_type: "Threat Model Request"
  sla_response_hours: 24
  sla_resolution_days: 14

calendar:
  provider: outlook  # or google
  tm_team_emails:
    - security-alice@company.com
    - security-bob@company.com
  session_duration_minutes: 90
  buffer_minutes: 15
  working_hours:
    start: 9
    end: 17

findings:
  database: sqlite:///findings.db
  severity_sla_days:
    critical: 7
    high: 30
    medium: 90
    low: 180

agent:
  model: claude-sonnet-4-20250514
  temperature: 0.3
  # api_key: set via ANTHROPIC_API_KEY env var
